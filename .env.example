# Shared password for /admin (no user accounts in v1).
ADMIN_PASSWORD=

# Optional: back up every uploaded/synced image to a GitHub branch,
# permanently (deleting an image in the app never removes its backup). Uses
# a fine-grained personal access token with Contents: Read and write on the
# target repo. Leave blank to disable.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=solidusbm/lookatDis
GITHUB_BACKUP_BRANCH=image-backups

# Optional: enables "Import from Canva" and auto-syncing images from a
# linked Canva design. Register an integration at canva.com/developers to
# get a client ID/secret, and set its redirect URL to match
# CANVA_REDIRECT_URI below exactly. Leave all three blank to disable.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/admin/canva/callback
